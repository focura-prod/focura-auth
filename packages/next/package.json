{
  "name": "@focura-prod/auth-next",
  "version": "1.1.8",
  "description": "Production-ready Next.js authentication with NextAuth.js. Drop-in auth with credentials, Google OAuth, 2FA, email verification, and password reset.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./components": {
      "import": "./dist/components/index.js",
      "types": "./dist/components/index.d.ts"
    },
    "./hooks": {
      "import": "./dist/hooks/index.js",
      "types": "./dist/hooks/index.d.ts"
    },
    "./api": {
      "import": "./dist/api/index.js",
      "types": "./dist/api/index.d.ts"
    },
    "./email": {
      "import": "./dist/email/index.js",
      "types": "./dist/email/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "peerDependencies": {
    "next": "^14.0.0 || ^15.0.0",
    "next-auth": "^4.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": false
    },
    "next-auth": {
      "optional": false
    },
    "react": {
      "optional": false
    },
    "react-dom": {
      "optional": false
    }
  },
  "dependencies": {
    "argon2": "^0.44.0",
    "nodemailer": "^7.0.0",
    "otplib": "^13.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@hookform/resolvers": "^3.0.0",
    "@types/nodemailer": "^6.4.0",
    "@types/react": "^19.0.0",
    "@vitest/coverage-v8": "^4.1.11",
    "jsdom": "^30.0.1",
    "react-hook-form": "^7.50.0",
    "react-hot-toast": "^2.4.0",
    "tsup": "^8.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "keywords": [
    "nextjs",
    "next-auth",
    "authentication",
    "auth",
    "2fa",
    "oauth",
    "credentials",
    "google"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/focura-prod/focura-auth.git",
    "directory": "packages/next"
  },
  "homepage": "https://github.com/focura-prod/focura-auth#readme",
  "bugs": {
    "url": "https://github.com/focura-prod/focura-auth/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  }
}
